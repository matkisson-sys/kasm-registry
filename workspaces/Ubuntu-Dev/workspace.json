{
  "friendly_name": "Ubuntu 24 Dev (Python • Node • Java)",
  "image_src": "ubuntu.png",
  "description": "Ubuntu 24 (Kasm) dev image with Python (pyenv + Poetry), Node (nvm + pnpm/yarn), Java (Temurin 21 + Maven + Gradle), VSCodium fullscreen, Chrome for SSO.",
  "cores": 8,
  "memory": 16384,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit",
  "docker_registry": "https://index.docker.io/v1/",
  "categories": ["Development"],
  "require_gpu": false,
  "enabled": true,
  "image_type": "Container",

  "persistent_profile_path": "/mnt/persistance/{username}/{image_id}",

  "run_config": {
    "hostname": "kasm",
    "environment": {
      "BROWSER": "/usr/bin/google-chrome-stable"
    }
  },

  "exec_config": {
    "go": {
      "user": "1000",
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "user": "1000",
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },

  "architecture": ["amd64"],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "matkissonce/kasm-ubuntu-dev",
      "uncompressed_size_mb": 9260,
      "available_tags": ["1.0.0"]
    }
  ],

  "name": "kasmweb/core-ubuntu-noble:1.17.0"
}
