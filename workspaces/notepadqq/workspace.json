{
  "friendly_name": "Notepadqq (Debian, App Mode)",
  "image_src": "notepadqq.webp",
  "description": "Lean Notepadqq app-only workspace on Debian 12 (smaller than Ubuntu).",
  "cores": 1,
  "memory": 768,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit",
  "docker_registry": "https://index.docker.io/v1/",
  "categories": ["Editors", "Development"],
  "require_gpu": false,
  "enabled": true,
  "image_type": "Container",
  "persistent_profile_path": "/mnt/persistance/{username}/{image_id}",
  "run_config": { "hostname": "kasm" },
  "exec_config": {
    "go":     { "user": "1000", "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'" },
    "assign": { "user": "1000", "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'" }
  },
  "architecture": ["amd64"],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "matkissonce/kasm-notepadqq",
      "uncompressed_size_mb": 1090,
      "available_tags": ["1.0.0"]
    }
  ],
  "name": "matkissonce/kasm-notepadqq:1.0.0"
}
